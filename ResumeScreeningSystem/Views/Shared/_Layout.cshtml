<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Resume Screening System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar {
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%) !important;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            padding: 15px 0;
            border-bottom: 3px solid #8b5cf6;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 22px;
            color: white !important;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.3s ease;
            padding: 8px 16px;
            border-radius: 12px;
        }

            .navbar-brand:hover {
                background: rgba(255, 255, 255, 0.1);
                transform: translateY(-2px);
            }

        .brand-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            box-shadow: 0 4px 12px rgba(139, 92, 246, 0.4);
        }

        .nav-link {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 600;
            font-size: 15px;
            padding: 10px 18px !important;
            margin: 0 4px;
            border-radius: 10px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .nav-link:hover {
                color: white !important;
                background: rgba(139, 92, 246, 0.2);
                transform: translateY(-2px);
            }

            .nav-link.active {
                background: rgba(139, 92, 246, 0.3);
                color: white !important;
            }

            .nav-link i {
                font-size: 18px;
            }

        .dropdown-toggle::after {
            margin-left: 8px;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-avatar {
            width: 35px;
            height: 35px;
            background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            box-shadow: 0 2px 8px rgba(139, 92, 246, 0.4);
        }

        .dropdown-menu {
            border: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            border-radius: 12px;
            padding: 12px;
            margin-top: 12px;
            min-width: 220px;
        }

        .dropdown-item {
            padding: 10px 15px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .dropdown-item:hover {
                background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
                transform: translateX(5px);
            }

            .dropdown-item i {
                font-size: 16px;
                color: #8b5cf6;
            }

        .dropdown-item-text {
            padding: 10px 15px;
            font-size: 13px;
        }

        .dropdown-divider {
            margin: 8px 0;
            border-color: #e2e8f0;
        }

        .role-badge {
            display: inline-block;
            padding: 4px 12px;
            background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
            color: white;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .main-container {
            flex: 1;
            padding: 30px 15px;
        }

        .alert {
            border: none;
            border-radius: 14px;
            padding: 16px 20px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 12px;
            animation: slideIn 0.3s ease-out;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .alert-success {
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
            color: #166534;
            border-left: 4px solid #22c55e;
        }

        .alert-danger {
            background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
            color: #991b1b;
            border-left: 4px solid #ef4444;
        }

        .alert-info {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            color: #1e40af;
            border-left: 4px solid #3b82f6;
        }

        .alert i {
            font-size: 20px;
        }

        .alert strong {
            font-weight: 700;
        }

        .btn-close {
            margin-left: auto;
        }

        .footer {
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
            color: rgba(255, 255, 255, 0.8);
            padding: 25px 0;
            margin-top: auto;
            border-top: 3px solid #8b5cf6;
            box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .footer-text {
            font-size: 14px;
            font-weight: 500;
            margin: 0;
        }

        .footer-badge {
            background: rgba(139, 92, 246, 0.2);
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #c4b5fd;
        }

        .navbar-toggler {
            border: 2px solid rgba(255, 255, 255, 0.2);
            padding: 8px 12px;
            border-radius: 8px;
        }

            .navbar-toggler:focus {
                box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.3);
            }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255, 255, 255, 0.8%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        @@media (max-width: 991px) {
            .navbar-nav {
                padding: 15px 0;
            }

            .nav-link {
                margin: 4px 0;
            }

            .footer-content {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon">
                        <i class="bi bi-file-earmark-text-fill"></i>
                    </div>
                    <span>Resume Screening System</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        @if (Context.Session.GetString("UserRole") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Recruiter" asp-action="Index">
                                    <i class="bi bi-people-fill"></i>
                                    Recruiters
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="JobPosting" asp-action="Index">
                                    <i class="bi bi-briefcase-fill"></i>
                                    Job Postings
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Resume" asp-action="Index">
                                <i class="bi bi-file-earmark-text"></i>
                                Resumes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ResumeScore" asp-action="Index">
                                <i class="bi bi-graph-up-arrow"></i>
                                Score Analysis
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-info">
                                    <div class="user-avatar">
                                        @if (Context.Session.GetString("UserRole") == "Admin")
                                        {
                                            <i class="bi bi-shield-fill-check"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-fill"></i>
                                        }
                                    </div>
                                    <span>@Context.Session.GetString("Username")</span>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                <li>
                                    <span class="dropdown-item-text">
                                        <strong>Role:</strong>
                                        <span class="role-badge">@Context.Session.GetString("UserRole")</span>
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right"></i>
                                        Logout
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <div>
                    <strong>Success!</strong> @TempData["Success"]
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>
                    <strong>Error!</strong> @TempData["Error"]
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    <strong>Info!</strong> @TempData["Info"]
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <p class="footer-text">
                    <i class="bi bi-c-circle"></i> 2024 Resume Screening System - Powered by AI
                </p>
                <span class="footer-badge">
                    <i class="bi bi-shield-check"></i> Secure & Professional
                </span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>